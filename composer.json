{
    "name": "goodport/laravel-auto-moderator",
    "description": "Content moderation profiles with built-in checks, synchronous cases, and background runs.",
    "type": "library",
    "homepage": "https://github.com/goodport/laravel-auto-moderator",
    "license": "MIT",
    "authors": [
        {
            "name": "goodport"
        }
    ],
    "keywords": [
        "laravel",
        "moderation",
        "content-moderation",
        "profanity",
        "stop-words",
        "toxicity"
    ],
    "require": {
        "ext-mbstring": "*",
        "consoletvs/profanity": "^3.5",
        "goodport/laravel-ai-moderator": "^2.2",
        "laravel/framework": "^12.62|^13.0",
        "php": "^8.3"
    },
    "require-dev": {
        "laravel/pint": "^1.26",
        "orchestra/testbench": "^10.6|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Goodport\\AutoModerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goodport\\AutoModerator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Goodport\\AutoModerator\\AutoModeratorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
